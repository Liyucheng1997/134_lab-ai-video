# 复制为 .env 并填入你的密钥
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# 可选覆盖项：
# DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_MAX_OUTPUT_TOKENS=8192    # 长视频中文全文的最大输出 token
# TRANSLATE_MAX_ZH_SEGMENT_CHARS=42  # 完整中文句子过长时才按逗号/分号软切分；0=关闭
# ---- Claude Code 翻译引擎（用本机已登录的 Claude 订阅额度，无需 API key）----
# CLAUDE_CODE_CLI=                   # claude 可执行文件路径，留空自动从 PATH 查找
# CLAUDE_CODE_MODEL=sonnet           # sonnet（默认，Sonnet 5）/ opus / haiku 或完整模型名
# CLAUDE_CODE_EFFORT=medium          # low / medium / high / max；medium 速度快且质量够用
# CLAUDE_CODE_TIMEOUT=1800           # 单次调用超时（秒），长视频整篇翻译需要留足时间
# ---- yt-dlp 反机器人：YouTube 提示 Sign in to confirm you're not a bot 时配置 ----
# YTDLP_COOKIE_FILE=              # 推荐。浏览器导出的 cookies.txt 绝对路径
# YTDLP_COOKIES_FROM_BROWSER=     # 备选。chrome / edge / firefox；需先完全退出该浏览器
# YouTube 的 n challenge 需要 JS 运行时 + yt-dlp 官方 EJS 解算脚本，缺一个就只剩图片流
# YTDLP_JS_RUNTIME=               # 留空自动查找 deno / node，如 node:D:\Nodejs\node.exe
# YTDLP_REMOTE_COMPONENTS=ejs:github  # 允许 yt-dlp 从 GitHub 拉取解算脚本；置空则关闭
# WHISPER_MODEL=small            # 或 large-v3-turbo（质量更好，首次需联网下载）
# WHISPER_DEVICE=cuda
# ---- TTS 配音引擎：仅 F5-TTS ----
# TTS_ENGINE=f5
# TTS_VOICE=人工老龙凤            # 默认音色
# TTS_SPEED=1.00                 # 后期语速倍率；F5 推理保持原速，最终音轨用该倍率调速
# TTS_GAP_MIN=0.08              # 段间最短停顿（秒）
# TTS_GAP_MAX=0.45             # 段间最长停顿（秒，去掉原视频大段空白）

# F5-TTS（本地·音色克隆）：内置音色 + 自定义参考音频克隆
# TTS_REF_AUDIO=                 # 自定义参考音频 wav/flac 路径（留空用内置音色）
# TTS_REF_TEXT=                  # 参考音频对应文字
# F5_TTS_PARALLEL=4              # F5 字幕段并发数，默认 4；显存不足时可降为 2 或 1

# SUB_FONT=Microsoft YaHei
# SUB_FONTSIZE=54
# ---- 遮挡原片烧死的英文字幕（界面第 5 步「遮挡原字幕」复选框，这里设默认值/外观）----
# SUB_COVER_ORIGINAL=0           # 1=默认勾选「遮挡原字幕」；0=默认不勾
# SUB_COVER_COLOR=black          # 色条颜色：ffmpeg 颜色名或 #RRGGBB
# SUB_COVER_OPACITY=0.9          # 默认不透明度 0~1（界面可逐条调）；100% 完全盖死白字
# SUB_COVER_HEIGHT=0.22          # 默认色条高度占画面比例 0.05~0.45；原字幕偏上就调大
# BILIBILI_TID=228                 # 228=知识/社科·法律·心理
# BILIBILI_COPYRIGHT=1             # 1=自制；2=转载
